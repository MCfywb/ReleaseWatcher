<Window x:Class="ReleaseWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:anim="clr-namespace:ReleaseWatcher.App.Animation"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="ReleaseWatcher">

    <!--
        应用主页 —— 一体化标题栏布局（2026-10-09，参照用户提供的截图）。

        结构（自上而下）：
            1. 标题栏（与窗口一体）：汉堡按钮 + 应用名 + 窗口控制按钮
            2. 主体：Sidebar（可展开/收起，带图标）+ 内容区（四页切换）
            3. 状态栏

        关键实现：
            · WindowStyle=None + WindowChrome：去掉系统标题栏，但保留
              拖动、边缘缩放、Win+方向键贴边、Aero Snap 等系统行为
              （这些由 WindowChrome 的 CaptionHeight / ResizeBorderThickness 提供，
              手写 DragMove 做不到）。
            · 应用名在标题栏；主题选择在「设置」页，不在主页（用户决定）。
            · 「设计系统」入口同属开发调参工具，一并放在设置页。

        所有颜色取自设计系统画刷，不硬编码；新增尺寸键进 Spacing.xaml（D-026）。
    -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="{StaticResource Size.ToolbarHeight}"
            ResizeBorderThickness="{StaticResource Size.ResizeBorderThickness}"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!--
            bool → Visibility 转换：用于把 ViewModel 的 IsBusy（bool）
            接到 AnimatedVisibilityHelper.AnimatedVisibility（Visibility），
            实现"加载时淡入旋转环、结束时淡出"。
        -->
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
            图标字形：Segoe Fluent Icons 优先，回退 Segoe MDL2 Assets。

            两者码点基本兼容（Fluent 是 MDL2 的更新版），
            故优先取 Fluent 以获得更现代的图形，缺失时自动回退。
            WPF FontFamily 支持逗号分隔的回退列表。

            实测记录（2026-10-10）：本机 segmdl2.ttf 已安装
            （内部 Family name 为 "Segoe MDL2 Assets"）；
            Segoe Fluent Icons 未安装（无 SegFluentIcons.ttf）。
            用户已计划安装该字体后再验收；
            届时若两字体均已安装，将按列表优先渲染 Fluent 图形。
        -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!--
                刻意不设 HorizontalAlignment：对齐由外层按钮的
                HorizontalContentAlignment 决定（展开靠左 / 收起居中）。
                固定 Center 会让"展开时汉堡靠左"失效。
            -->
        </Style>

        <!--
            ToolTip 隐式样式。

            背景问题：WPF 的 ToolTip 默认走系统样式（浅灰底 + 深色字），
            但本应用有全局隐式 TextBlock 样式（见 Typography.xaml），
            会把 ToolTip 内文字刷成 Brush.Text.Primary ——
            深色主题下那是**浅色**，浅色字落在浅色底上就看不见了，
            表现为"悬停提示框是空白的"（2026-10-09 用户反馈）。

            修法：显式给 ToolTip 设定 Surface 背景与 Border 描边，
            使文字与其底色始终来自同一套语义色（见 D-026 单一来源要求）。
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource Space.Padding.S}" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <!--
            Sidebar 顶部的展开/收起按钮。
            刻意不用 ChromeButton：后者带 IsHitTestVisibleInChrome，
            那是给标题栏（非客户区）用的，客户区按钮不需要。
        -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 与导航项同高（40），让汉堡与下方图标左对齐成一列。 -->
            <Setter Property="Height" Value="{StaticResource Size.NavItemHeight}" />
            <!--
                与导航项一致：上下留白各 4、整行铺满（不设固定宽度）。
                内容靠左 —— 48 宽图标容器贴左，使汉堡图标与下方导航图标同列。
                用户 2026-10-10 要求：展开态汉堡按钮也是整行。
            -->
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左（与下方导航图标对齐），收起时居中。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            窗口控制图标几何 —— Windows 11 标题栏标准图形。

            用 Path 而非图标字体的原因：字形依赖 Segoe MDL2 Assets /
            Segoe Fluent Icons 是否安装，缺失即渲染成方框（本项目反复踩坑）。
            Path 是矢量图形，零字体依赖，任何机器上外观一致。

            坐标系 10×10，与 Windows 原始字形一致；
            最大化/还原用同一图形的两种状态（见 UpdateMaximizeIcon）。
        -->
        <Geometry x:Key="WindowChrome.Geometry.Minimize">M0,5 H10</Geometry>
        <Geometry x:Key="WindowChrome.Geometry.Maximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
        <!-- 还原：后层方框缺右上角，前层方框缺左下角 —— Windows 的经典画法 -->
        <Geometry x:Key="WindowChrome.Geometry.Restore">M4.5,0.5 H9.5 V5.5 H8.5 M0.5,4.5 H5.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="WindowChrome.Geometry.Close">M0,0 L10,10 M10,0 L0,10</Geometry>

        <!--
            窗口控制图标：描边跟随按钮前景色，尺寸固定 10×10，在按钮内居中。
        -->
        <Style x:Key="WindowChromeGlyph" TargetType="Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <!-- 1px 细线是 Windows 标题栏的标志；圆端点/圆拐角让线段衔接平滑 -->
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <!-- 关键：让 1px 描边对齐整数像素，避免发虚 -->
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            标题栏窗口控制按钮（最小化 / 最大化 / 关闭）。
            无边框、hover 提亮 —— 贴近系统标题栏的观感。
            颜色全部走设计系统画刷。
            内容用 Path 而非图标字形：矢量图形不依赖字体是否安装
            （字形缺字体即渲染成方框，见 IconGlyph 处的踩坑记录）。
        -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="{StaticResource Size.ToolbarHeight}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment，
                                 否则固定值会覆盖外面的设置。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Sidebar 导航项：图标 + 文字，选中态提亮。
            收起时文字由代码切换可见性（见 ToggleSidebar_Click）。
        -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 导航项高度 40（Fluent 规范），不用输入框高度的 36。 -->
            <Setter Property="Height" Value="{StaticResource Size.NavItemHeight}" />
            <!--
                仅保留纵向留白（上下各 4），水平留白置 0：
                这样图标容器从 x=0 起算，与汉堡按钮（Margin=0）同行对齐成列；
                横向不留白也契合 Fluent —— 选中/悬停背景铺满整行。
                图标与文字的横向间距改由导航项内容里的固定 48 宽图标容器承担
                （图标居中 → 右缘 x=32，文字 x=48，自然形成 16px 间距）。
            -->
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左，收起时居中（见 ToggleSidebar_Click）。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Selected}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 占位页居中提示 -->
        <Style x:Key="PlaceholderTitle" TargetType="TextBlock"
               BasedOn="{StaticResource Text.PageTitle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlaceholderBody" TargetType="TextBlock"
               BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Space.Padding.Top.S}" />
        </Style>
    <!--
                            状态色样式：随ViewModel 的布尔属性切换前景色。
                            必须带 x:Key（显式样式）—— 无 key 即为隐式样式，
                            会与全局那条 TextBlock 隐式样式重复定义，
                            运行时合并资源字典将抛 "Item has already been added"
                            （守卫 WindowXaml_MustNotDuplicateImplicitStyleKeys）。
                        -->
                        <Style x:Key="DetectionStatusText"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource Text.Body}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏（与窗口一体） ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Height="{StaticResource Size.ToolbarHeight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    应用名：属于标题拖动区（不加 IsHitTestVisibleInChrome）。
                    汉堡按钮已按用户要求移至 Sidebar 顶部，不占标题栏。
                -->
                <!--
                    Margin 用 Space.Margin.*（Thickness），不用 Space.Padding.Horizontal.*
                    —— "左右双向"的 padding 键用于 Margin 会让相邻元素间隙被翻倍，
                    该规则由 PreviewPage_InterItemGapsMustUseRightOnlyMargin 守护。
                -->
                <TextBlock Grid.Column="0"
                           Margin="{StaticResource Space.Margin.M}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.CardTitle}"
                           Text="ReleaseWatcher" />

                <!--
                    窗口控制：最小化 / 最大化(还原) / 关闭。
                    图标为 Path 矢量图形（Windows 标准字形），
                    不依赖 Segoe 字体是否安装 —— 字体缺失会渲染成方框。
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化">
                        <Path Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Minimize}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Maximize_Click"
                            ToolTip="最大化">
                        <Path x:Name="MaximizeIcon"
                              Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Maximize}" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Close_Click"
                            ToolTip="关闭">
                        <Path Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Close}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--
                    Width 由代码设置（ToggleSidebar_Click / 构造函数）：
                    ColumnDefinition.Width 是 GridLength，而 Size.SidebarWidth 是
                    sys:Double —— 直接绑定会抛 XamlParseException（编译期不报错）。
                    尺寸仍在 Spacing.xaml 里，只是经代码读取，保持单一来源。
                -->
                <ColumnDefinition x:Name="SidebarColumn" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <!--
                        汉堡按钮：按用户要求放在 Sidebar 顶部，不再占标题栏。
                        用 SidebarToggleButton（无边框 + hover），
                        不用 ChromeButton —— 后者带 IsHitTestVisibleInChrome，
                        仅标题栏区域需要。
                    -->
                    <Button x:Name="HamburgerButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SidebarToggleButton}"
                            Click="ToggleSidebar_Click"
                            ToolTip="展开 / 收起侧边栏">
                        <!--
                            图标固定在一个宽 48（= 收起态 sidebar 宽度）的容器内居中，
                            因此展开与收起时图标的绝对位置不变，只有文字隐藏。
                            这同时也让汉堡与下方导航图标左对齐成一列。
                        -->
                        <Border Width="48">
                            <TextBlock Style="{StaticResource IconGlyph}"
                                       HorizontalAlignment="Center"
                                       Text="&#xE700;" />
                        </Border>
                    </Button>

                    <!-- 设置项固定底部（与截图一致） -->
                    <RadioButton x:Name="SettingsNav"
                                 DockPanel.Dock="Bottom"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="Nav"
                                 Tag="Settings"
                                 Checked="Nav_Checked"
                                 ToolTip="设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 与上方导航项结构一致：图标列固定 48 + 文字列 Auto。
                                     此前设置项只定义图标列、文字放隐式列（Grid.Column=1），
                                     导致展开态「设置」文字错位。 -->
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsIcon"
                                       Style="{StaticResource IconGlyph}"
                                       HorizontalAlignment="Center"
                                       Text="&#xE713;" />

                            <TextBlock Grid.Column="1"
                                       x:Name="SettingsNavText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}"
                                       Text="设置" />
                        </Grid>
                    </RadioButton>

                    <!-- 主导航 -->
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Space.Padding.Top.S}">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Overview"
                                     IsChecked="True"
                                     Checked="Nav_Checked"
                                     ToolTip="概览">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OverviewIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE80F;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="OverviewNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="概览" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="ReposNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Repos"
                                     Checked="Nav_Checked"
                                     ToolTip="检测列表">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReposIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE71D;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="ReposNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="检测列表" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="DownloadsNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Downloads"
                                     Checked="Nav_Checked"
                                     ToolTip="下载">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownloadsIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE896;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="DownloadsNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="下载" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== 内容区（四页切换） ==================== -->
            <Grid Grid.Column="1">

                <!-- 概览：统计概览（绑定 OverviewViewModel） -->
                <Grid x:Name="OverviewPage">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 页头：标题 + 刷新 -->
                        <Grid Margin="{StaticResource Size.ContentPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.PageTitle}"
                                           Text="概览" />
                                <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                           Style="{StaticResource Text.Secondary}"
                                           Text="{Binding LastCheckedText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- 加载指示：IsBusy 为真时淡入旋转环，结束淡出 -->
                                <Control Style="{StaticResource BusyRing}"
                                         VerticalAlignment="Center"
                                         Margin="{StaticResource Space.Margin.Right.S}"
                                         Visibility="Collapsed"
                                         anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="刷新"
                                        Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 空态：无仓库时显示引导 -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="560"
                                    Visibility="Visible"
                                    anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding EmptyStateVisibility}">
                            <TextBlock Style="{StaticResource PlaceholderTitle}"
                                       Text="尚无监控数据" />
                            <TextBlock Style="{StaticResource PlaceholderBody}"
                                       Text="点击右上角「刷新」开始检测已配置的仓库。当前使用内置样例数据演示，接入 GitHub 后此处将显示真实仓库。" />
                        </StackPanel>

                        <!-- 统计内容 -->
                        <ScrollViewer Grid.Row="1"
                                      Padding="{StaticResource Size.ContentPadding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed"
                                      anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding ContentVisibility}">
                            <StackPanel MaxWidth="900">

                                <TextBlock Style="{StaticResource Text.SectionTitle}"
                                           Text="检测概况" />

                                <!--
                                    四个统计卡片横向排列。
                                    卡片间距用 Space.Margin.Right 单边键 ——
                                    用双向 padding 键会让相邻卡片间隙翻倍
                                    （见PreviewPage_InterItemGapsMustUseRightOnlyMargin 守卫）。
                                -->
                                <StackPanel Margin="{StaticResource Space.Padding.Top.M}"
                                            Orientation="Horizontal">
                                    <Border Margin="{StaticResource Space.Margin.Right.S}"
                                            MinWidth="150"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="监控仓库" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding TotalCount}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="{StaticResource Space.Margin.Right.S}"
                                            MinWidth="150"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="有新版本" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding UpdateCount}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="{StaticResource Space.Margin.Right.S}"
                                            MinWidth="150"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="已是最新" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Foreground="{DynamicResource Brush.Success}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding UpToDateCount}" />
                                        </StackPanel>
                                    </Border>

                                    <Border MinWidth="150"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="检测失败" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Foreground="{DynamicResource Brush.Error}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding ErrorCount}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                           Style="{StaticResource Text.SectionTitle}"
                                           Text="最近检测结果" />

                                <!--
                                    概览里只列前若干条，避免与检测列表页重复。
                                    点击"查看全部"切到列表页。
                                -->
                                <Border Margin="{StaticResource Space.Padding.Top.M}"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ItemsControl ItemsSource="{Binding RecentRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="{StaticResource Space.Margin.Right.S}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Body}"
                                                               Text="{Binding RepositoryText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RepositoryText}" />

                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Body}"
                                                               Text="{Binding LatestVersionText}" />

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Secondary}"
                                                               Text="{Binding StatusText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding StatusText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                                           Style="{StaticResource Text.Caption}"
                                           Text="完整列表见「检测列表」页。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!--
                    检测列表：仓库 × 最新版本 × 检测结论。

                    DataContext 沿用窗口级的 OverviewViewModel（两页共享同一次检测），
                    故列表相关绑定需经 DataContext.RepositoryList 下钻。
                -->
                <Grid x:Name="ReposPage" Visibility="Collapsed"
                      DataContext="{Binding DataContext.RepositoryList, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 页头 -->
                        <Grid Margin="{StaticResource Size.ContentPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.PageTitle}"
                                           Text="检测列表" />
                                <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                           Style="{StaticResource Text.Secondary}"
                                           Text="{Binding LastRunText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- 加载指示：IsBusy 为真时淡入旋转环，结束淡出 -->
                                <Control Style="{StaticResource BusyRing}"
                                         VerticalAlignment="Center"
                                         Margin="{StaticResource Space.Margin.Right.S}"
                                         Visibility="Collapsed"
                                         anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Content="立即检查"
                                        Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 空态 -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="560"
                                    Visibility="Visible"
                                    anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding EmptyStateVisibility}">
                            <TextBlock Style="{StaticResource PlaceholderTitle}"
                                       Text="尚无监控仓库" />
                            <TextBlock Style="{StaticResource PlaceholderBody}"
                                       Text="点击「立即检查」开始检测。当前使用内置样例数据演示。" />
                        </StackPanel>

                        <!--
                            结果列表。用 ItemsControl + DataTemplate 手写行，
                            而非 DataGrid：
                            DataGrid 会带来一整套默认视觉（斑马纹、列头按钮、
                            选中高亮），与本项目设计系统不一致，
                            改造成本高于直接手写；
                            且本列表只读、不需排序与编辑，
                            DataGrid 的能力用不上。
                        -->
                        <ScrollViewer Grid.Row="1"
                                      Padding="{StaticResource Size.ContentPadding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed"
                                      anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding ListVisibility}">
                            <StackPanel MaxWidth="1100">

                                <!-- 表头 -->
                                <Grid Margin="{StaticResource Space.Margin.Right.S}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource Text.Caption}" Text="仓库" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="最新版本" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="当前基准" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="检测结论" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" Text="发布时间" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="{StaticResource Space.Padding.Top.XS}"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="{StaticResource Space.Padding.Horizontal.S}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Text.Body}"
                                                                   Text="{Binding RepositoryText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding RepositoryText}" />
                                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                                   Text="{Binding AssetsText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding AssetsText}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Body}"
                                                               Text="{Binding LatestVersionText}" />

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Secondary}"
                                                               Text="{Binding KnownVersionText}" />

                                                    <!--
                                                        状态色由ViewModel 的两个布尔属性驱动，
                                                        用 DataTrigger 切换，不写转换器：
                                                        三个状态（有更新/正常/失败）的映射
                                                        直接写在触发器里一目了然。
                                                    -->
                                                    <TextBlock Grid.Column="3"
                                                               Style="{StaticResource DetectionStatusText}"
                                                               Text="{Binding StatusText}"
                                                               ToolTip="{Binding StatusText}" />

                                                    <TextBlock Grid.Column="4"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Text.Caption}"
                                                               Text="{Binding PublishedText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 下载（占位） -->
                <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Style="{StaticResource PlaceholderTitle}"
                                   Text="下载" />
                        <TextBlock Style="{StaticResource PlaceholderBody}"
                                   Text="将在此展示下载任务与进度（aria2 接入后）。" />
                    </StackPanel>
                </Grid>

                <!-- 设置 -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer Padding="{StaticResource Size.ContentPadding}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="640">

                            <TextBlock Style="{StaticResource Text.SectionTitle}"
                                       Text="外观" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="主题" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="选择应用配色。选择会立即生效并保存；「跟随系统」下切换系统深浅色时界面实时跟随。" />

                                    <StackPanel Margin="{StaticResource Space.Padding.Top.M}"
                                                Orientation="Horizontal">
                                        <TextBlock Margin="{StaticResource Space.Margin.Right.S}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="主题" />
                                        <ComboBox x:Name="ThemeSelector"
                                                  Width="140"
                                                  SelectionChanged="ThemeSelector_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="开发者" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="设计系统" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="查看语义色、字阶、控件三态与间距标尺。用于设计系统的肉眼核对（D-048 验收载体）。" />

                                    <Button x:Name="OpenDesignSystemButton"
                                            Margin="{StaticResource Space.Padding.Top.M}"
                                            HorizontalAlignment="Left"
                                            Content="打开设计系统"
                                            Click="OpenDesignSystem_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="关于" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="ReleaseWatcher" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="GitHub Release 监控与下载工具。" />
                                    <TextBlock x:Name="AboutPathsText"
                                               Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Caption}"
                                               Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Size.ContentPadding}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Text.Caption}"
                       Text="就绪" />
        </Border>
    </Grid>
</Window>
