<Window x:Class="ReleaseWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:anim="clr-namespace:ReleaseWatcher.App.Animation"
        xmlns:converters="clr-namespace:ReleaseWatcher.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="ReleaseWatcher">

    <!--
        应用主页 —— 一体化标题栏布局（2026-10-09，参照用户提供的截图）。

        结构（自上而下）：
            1. 标题栏（与窗口一体）：汉堡按钮 + 应用名 + 窗口控制按钮
            2. 主体：Sidebar（可展开/收起，带图标）+ 内容区（四页切换）
            3. 状态栏

        关键实现：
            · WindowStyle=None + WindowChrome：去掉系统标题栏，但保留
              拖动、边缘缩放、Win+方向键贴边、Aero Snap 等系统行为
              （这些由 WindowChrome 的 CaptionHeight / ResizeBorderThickness 提供，
              手写 DragMove 做不到）。
            · 应用名在标题栏；主题选择在「设置」页，不在主页（用户决定）。
            · 「设计系统」入口同属开发调参工具，一并放在设置页。

        所有颜色取自设计系统画刷，不硬编码；新增尺寸键进 Spacing.xaml（D-026）。
    -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="{StaticResource Size.ToolbarHeight}"
            ResizeBorderThickness="{StaticResource Size.ResizeBorderThickness}"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!--
            bool → Visibility 转换：用于把 ViewModel 的 IsBusy（bool）
            接到 AnimatedVisibilityHelper.AnimatedVisibility（Visibility），
            实现"加载时淡入旋转环、结束时淡出"。
        -->
        <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
            null → Collapsed（或 Invert 时相反）：用于三栏视图按 SelectedRow /
            SelectedRelease 是否为 null，让历史与详情卡片淡入淡出。
        -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <!--
            两值相等 → Visible：中栏给"最新合格"的 Release 打上"最新"标记。
        -->
        <converters:AreEqualToVisibilityConverter x:Key="AreEqualToVisibilityConverter" />

        <!-- 资产大小（字节 → "1.2 MB"）：下载资产列表逐文件展示用 -->
        <converters:FileSizeConverter x:Key="FileSizeConverter" />

        <!--
            概览结果行的仓库图标：git 分支矢量图形。
            用 Path 数据而非字体字形 —— 分支图形在 MDL2/Fluent 中码位不稳，
            几何数据跨机器一致（颜色仍走主题画刷）。
        -->
        <Geometry x:Key="Icon.Geometry.RepoBranch">M13,14C9.64,14 8.54,15.35 8.18,16.24C9.25,16.7 10,17.76 10,19A3,3 0 0,1 7,22A3,3 0 0,1 4,19C4,17.69 4.83,16.58 6,16.16V7.84C4.83,7.42 4,6.3 4,5A3,3 0 0,1 7,2A3,3 0 0,1 10,5C10,6.3 9.17,7.42 8,7.84V13.12C8.76,12.62 9.9,12 13,12C14,12 14.5,11.5 14.5,10.5V10H13L16,7L19,10H16.5V10.5C16.5,12.44 15.08,14 13,14M7,4A1,1 0 0,0 6,5A1,1 0 0,0 7,6A1,1 0 0,0 8,5A1,1 0 0,0 7,4M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18Z</Geometry>

        <!--
            概览"最近检测结果"的行容器：底部 1px 分隔线 + 悬停反白反馈。
            首行（AlternationIndex=0）不画分隔线，避免与卡片圆角相切。
            显式 x:Key 而非隐式样式 —— 隐式样式会被
            WindowXaml_MustNotDuplicateImplicitStyleKeys 守卫拦截。
        -->
        <Style x:Key="OverviewResultRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlternationIndex, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            检测列表三栏的列表（ListBox）：去默认边框与背景，由所在卡片承担。
            用 ListBox 而非 ItemsControl + 按钮的原因：SelectedItem 双向绑定 +
            容器级选中高亮 + 键盘上下键，选中态由容器样式统一保证
            （"选中行持续保持视觉高亮"，2026-10-11 用户要求）。
        -->
        <Style x:Key="PaneList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!--
            列表行容器：hover 反白、选中用 Accent 淡底并保持常亮
            （不随焦点丢失而消失），圆角与卡片内容对齐。
        -->
        <Style x:Key="PaneListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Margin="4,2"
                                Padding="10,8"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Button}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            三栏之间的拖拽分割条：平时只是一条细分隔线，悬停/聚焦时点亮为
            Accent，提示"这里可以拖"。命中区域为整条 8px 列，比线本身宽，
            便于抓取。拖拽结束保存比例（见 MainWindow.xaml.cs DragCompleted）。
        -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <!--
                铺满整条 8px 间距列（线画在正中），并且只改相邻两栏：
                PreviousAndNext 是"拖这条线，左右两栏此消彼长"的语义，
                配合像素列宽可避免第三栏跟着反方向移动。
            -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Line"
                                       Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{DynamicResource Brush.Border.Subtle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            图标字形：Segoe Fluent Icons 优先，回退 Segoe MDL2 Assets。

            两者码点基本兼容（Fluent 是 MDL2 的更新版），
            故优先取 Fluent 以获得更现代的图形，缺失时自动回退。
            WPF FontFamily 支持逗号分隔的回退列表。

            实测记录（2026-10-10）：本机 segmdl2.ttf 已安装
            （内部 Family name 为 "Segoe MDL2 Assets"）；
            Segoe Fluent Icons 未安装（无 SegFluentIcons.ttf）。
            用户已计划安装该字体后再验收；
            届时若两字体均已安装，将按列表优先渲染 Fluent 图形。
        -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!--
                刻意不设 HorizontalAlignment：对齐由外层按钮的
                HorizontalContentAlignment 决定（展开靠左 / 收起居中）。
                固定 Center 会让"展开时汉堡靠左"失效。
            -->
        </Style>

        <!--
            ToolTip 隐式样式。

            背景问题：WPF 的 ToolTip 默认走系统样式（浅灰底 + 深色字），
            但本应用有全局隐式 TextBlock 样式（见 Typography.xaml），
            会把 ToolTip 内文字刷成 Brush.Text.Primary ——
            深色主题下那是**浅色**，浅色字落在浅色底上就看不见了，
            表现为"悬停提示框是空白的"（2026-10-09 用户反馈）。

            修法：显式给 ToolTip 设定 Surface 背景与 Border 描边，
            使文字与其底色始终来自同一套语义色（见 D-026 单一来源要求）。
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource Space.Padding.S}" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <!--
            Sidebar 顶部的展开/收起按钮。
            刻意不用 ChromeButton：后者带 IsHitTestVisibleInChrome，
            那是给标题栏（非客户区）用的，客户区按钮不需要。
        -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 与导航项同高（40），让汉堡与下方图标左对齐成一列。 -->
            <Setter Property="Height" Value="{StaticResource Size.NavItemHeight}" />
            <!--
                与导航项一致：上下留白各 4、整行铺满（不设固定宽度）。
                内容靠左 —— 48 宽图标容器贴左，使汉堡图标与下方导航图标同列。
                用户 2026-10-10 要求：展开态汉堡按钮也是整行。
            -->
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左（与下方导航图标对齐），收起时居中。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            窗口控制图标几何 —— Windows 11 标题栏标准图形。

            用 Path 而非图标字体的原因：字形依赖 Segoe MDL2 Assets /
            Segoe Fluent Icons 是否安装，缺失即渲染成方框（本项目反复踩坑）。
            Path 是矢量图形，零字体依赖，任何机器上外观一致。

            坐标系 10×10，与 Windows 原始字形一致；
            最大化/还原用同一图形的两种状态（见 UpdateMaximizeIcon）。
        -->
        <Geometry x:Key="WindowChrome.Geometry.Minimize">M0,5 H10</Geometry>
        <Geometry x:Key="WindowChrome.Geometry.Maximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
        <!-- 还原：后层方框缺右上角，前层方框缺左下角 —— Windows 的经典画法 -->
        <Geometry x:Key="WindowChrome.Geometry.Restore">M4.5,0.5 H9.5 V5.5 H8.5 M0.5,4.5 H5.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="WindowChrome.Geometry.Close">M0,0 L10,10 M10,0 L0,10</Geometry>

        <!--
            窗口控制图标：描边跟随按钮前景色，尺寸固定 10×10，在按钮内居中。
        -->
        <Style x:Key="WindowChromeGlyph" TargetType="Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <!-- 1px 细线是 Windows 标题栏的标志；圆端点/圆拐角让线段衔接平滑 -->
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <!-- 关键：让 1px 描边对齐整数像素，避免发虚 -->
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            标题栏窗口控制按钮（最小化 / 最大化 / 关闭）。
            无边框、hover 提亮 —— 贴近系统标题栏的观感。
            颜色全部走设计系统画刷。
            内容用 Path 而非图标字形：矢量图形不依赖字体是否安装
            （字形缺字体即渲染成方框，见 IconGlyph 处的踩坑记录）。
        -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="{StaticResource Size.ToolbarHeight}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment，
                                 否则固定值会覆盖外面的设置。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Sidebar 导航项：图标 + 文字，选中态提亮。
            收起时文字由代码切换可见性（见 ToggleSidebar_Click）。
        -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 导航项高度 40（Fluent 规范），不用输入框高度的 36。 -->
            <Setter Property="Height" Value="{StaticResource Size.NavItemHeight}" />
            <!--
                仅保留纵向留白（上下各 4），水平留白置 0：
                这样图标容器从 x=0 起算，与汉堡按钮（Margin=0）同行对齐成列；
                横向不留白也契合 Fluent —— 选中/悬停背景铺满整行。
                图标与文字的横向间距改由导航项内容里的固定 48 宽图标容器承担
                （图标居中 → 右缘 x=32，文字 x=48，自然形成 16px 间距）。
            -->
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左，收起时居中（见 ToggleSidebar_Click）。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Selected}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 占位页居中提示 -->
        <Style x:Key="PlaceholderTitle" TargetType="TextBlock"
               BasedOn="{StaticResource Text.PageTitle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlaceholderBody" TargetType="TextBlock"
               BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Space.Padding.Top.S}" />
        </Style>
    <!--
                            状态色样式：随ViewModel 的布尔属性切换前景色。
                            必须带 x:Key（显式样式）—— 无 key 即为隐式样式，
                            会与全局那条 TextBlock 隐式样式重复定义，
                            运行时合并资源字典将抛 "Item has already been added"
                            （守卫 WindowXaml_MustNotDuplicateImplicitStyleKeys）。
                        -->
                        <Style x:Key="DetectionStatusText"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource Text.Body}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Error}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                        <!--
                            详情卡片"通道"文本：默认"正式版"，预发布/草稿时切换。
                            用显式 x:Key 样式（而非内联 Style），否则 WindowXaml 测试会把它
                            当成重复的隐式 TextBlock 样式（见 ArchitectureTests）。
                        -->
                        <Style x:Key="DetailChannelText"
                               TargetType="TextBlock"
                               BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Text" Value="正式版" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRelease.IsPrerelease}" Value="True">
                                    <Setter Property="Text" Value="预发布" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedRelease.IsDraft}" Value="True">
                                    <Setter Property="Text" Value="草稿" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏（与窗口一体） ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Height="{StaticResource Size.ToolbarHeight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    应用名：属于标题拖动区（不加 IsHitTestVisibleInChrome）。
                    汉堡按钮已按用户要求移至 Sidebar 顶部，不占标题栏。
                -->
                <!--
                    Margin 用 Space.Margin.*（Thickness），不用 Space.Padding.Horizontal.*
                    —— "左右双向"的 padding 键用于 Margin 会让相邻元素间隙被翻倍，
                    该规则由 PreviewPage_InterItemGapsMustUseRightOnlyMargin 守护。
                -->
                <TextBlock Grid.Column="0"
                           Margin="{StaticResource Space.Margin.M}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.CardTitle}"
                           Text="ReleaseWatcher" />

                <!--
                    窗口控制：最小化 / 最大化(还原) / 关闭。
                    图标为 Path 矢量图形（Windows 标准字形），
                    不依赖 Segoe 字体是否安装 —— 字体缺失会渲染成方框。
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化">
                        <Path Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Minimize}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Maximize_Click"
                            ToolTip="最大化">
                        <Path x:Name="MaximizeIcon"
                              Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Maximize}" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Close_Click"
                            ToolTip="关闭">
                        <Path Style="{StaticResource WindowChromeGlyph}"
                              Data="{StaticResource WindowChrome.Geometry.Close}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--
                    Width 由代码设置（展开 = 窗口宽 × 10% 与 120 取较大值，
                    收起 = 48）：ColumnDefinition.Width 是 GridLength，而比例宽度
                    需按窗口实际宽度运行时计算，无法用静态绑定表达。
                    下限 120 来自 Spacing.xaml 的 Size.SidebarWidth.Min（单一来源）。
                -->
                <ColumnDefinition x:Name="SidebarColumn" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <!--
                        汉堡按钮：按用户要求放在 Sidebar 顶部，不再占标题栏。
                        用 SidebarToggleButton（无边框 + hover），
                        不用 ChromeButton —— 后者带 IsHitTestVisibleInChrome，
                        仅标题栏区域需要。
                    -->
                    <Button x:Name="HamburgerButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SidebarToggleButton}"
                            Click="ToggleSidebar_Click"
                            ToolTip="展开 / 收起侧边栏">
                        <!--
                            图标固定在一个宽 48（= 收起态 sidebar 宽度）的容器内居中，
                            因此展开与收起时图标的绝对位置不变，只有文字隐藏。
                            这同时也让汉堡与下方导航图标左对齐成一列。
                        -->
                        <Border Width="48">
                            <TextBlock Style="{StaticResource IconGlyph}"
                                       HorizontalAlignment="Center"
                                       Text="&#xE700;" />
                        </Border>
                    </Button>

                    <!-- 设置项固定底部（与截图一致） -->
                    <RadioButton x:Name="SettingsNav"
                                 DockPanel.Dock="Bottom"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="Nav"
                                 Tag="Settings"
                                 Checked="Nav_Checked"
                                 ToolTip="设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 与上方导航项结构一致：图标列固定 48 + 文字列 Auto。
                                     此前设置项只定义图标列、文字放隐式列（Grid.Column=1），
                                     导致展开态「设置」文字错位。 -->
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsIcon"
                                       Style="{StaticResource IconGlyph}"
                                       HorizontalAlignment="Center"
                                       Text="&#xE713;" />

                            <TextBlock Grid.Column="1"
                                       x:Name="SettingsNavText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}"
                                       Text="设置" />
                        </Grid>
                    </RadioButton>

                    <!-- 主导航 -->
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Space.Padding.Top.S}">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Overview"
                                     IsChecked="True"
                                     Checked="Nav_Checked"
                                     ToolTip="概览">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OverviewIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE80F;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="OverviewNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="概览" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="ReposNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Repos"
                                     Checked="Nav_Checked"
                                     ToolTip="检测列表">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ReposIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE71D;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="ReposNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="检测列表" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="DownloadsNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Downloads"
                                     Checked="Nav_Checked"
                                     ToolTip="下载">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DownloadsIcon"
                                           Style="{StaticResource IconGlyph}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE896;" />
                                <TextBlock Grid.Column="1"
                                           x:Name="DownloadsNavText"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Body}"
                                           Text="下载" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== 内容区（四页切换） ==================== -->
            <Grid Grid.Column="1">

                <!-- 概览：统计概览（绑定 OverviewViewModel） -->
                <Grid x:Name="OverviewPage">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 页头：标题 + 摘要 + 立即检查（版式按 2026-10-11 用户提供截图） -->
                        <Grid Margin="{StaticResource Size.ContentPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.PageTitle}"
                                           Text="概览" />
                                <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                           Style="{StaticResource Text.Secondary}"
                                           Text="{Binding HeaderSubtitleText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- 加载指示：IsBusy 为真时淡入旋转环，结束淡出 -->
                                <Control Style="{StaticResource BusyRing}"
                                         VerticalAlignment="Center"
                                         Margin="{StaticResource Space.Margin.Right.S}"
                                         Visibility="Collapsed"
                                         anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="立即检测全部监控仓库">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Margin="{StaticResource Space.Margin.Right.S}"
                                                   FontSize="14"
                                                   Text="&#xE72C;" />
                                        <TextBlock Text="立即检查" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 空态：无仓库时显示引导 -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="560"
                                    Visibility="Visible"
                                    anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding EmptyStateVisibility}">
                            <TextBlock Style="{StaticResource PlaceholderTitle}"
                                       Text="尚无监控数据" />
                            <TextBlock Style="{StaticResource PlaceholderBody}"
                                       Text="点击右上角「立即检查」开始检测已配置的仓库。当前使用内置样例数据演示，接入 GitHub 后此处将显示真实仓库。" />
                        </StackPanel>

                        <!--
                            统计内容 —— 版式按 2026-10-11 用户提供截图重设计：
                            2×2 统计卡（数字按语义着色）→「最近检测结果 + 查看全部」→
                            结果卡（图标 + 名称/版本摘要 + 徽章 + 箭头），行点击跳转检测列表页。
                        -->
                        <ScrollViewer Grid.Row="1"
                                      Padding="{StaticResource Size.ContentPadding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed"
                                      anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding ContentVisibility}">
                            <StackPanel x:Name="OverviewContent">

                                <!--
                                    统计卡：宽屏一行四张，窗口变窄自动降为 2×2
                                    （列布局由 ApplyOverviewStatLayout 按可用宽度切换）。
                                    间距 8 走 8px 网格；边距各归其位，不用双向 padding 键
                                    （相邻间隙翻倍教训，见 D-046 第 11 条）。
                                -->
                                <Grid x:Name="OverviewStatGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="StatCardTotal"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="监控仓库" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding TotalCount}" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Text="持续跟踪中" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="StatCardUpdate"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="可用更新" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding UpdateCount}" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Text="有新版本发布" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="StatCardUpToDate"
                                            Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="已是最新" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Foreground="{DynamicResource Brush.Success}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding UpToDateCount}" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Text="当前无需更新" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="StatCardError"
                                            Grid.Column="3"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            Padding="{StaticResource Space.Padding.M}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="检测失败" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Metric}"
                                                       Text="{Binding ErrorCount}" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Text="运行状态正常" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 分区标题 + 查看全部（跳检测列表页） -->
                                <Grid Margin="{StaticResource Space.Padding.Top.L}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.SectionTitle}"
                                               Text="最近检测结果" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center">
                                        <Hyperlink Click="ViewAllResults_Click"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   TextDecorations="{x:Null}">
                                            查看全部 →
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>

                                <!--
                                    结果卡：行 = 图标 + 名称/版本摘要 + 徽章 + 箭头。
                                    点击行：在检测列表页选中该仓库并跳转（OverviewRow_Click）。
                                    ClipToBounds 让行 hover 背景不溢出卡片圆角。
                                -->
                                <Border Margin="{StaticResource Space.Padding.Top.M}"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        ClipToBounds="True">
                                    <ItemsControl AlternationCount="100"
                                                  ItemsSource="{Binding RecentRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OverviewResultRow}"
                                                        MouseLeftButtonDown="OverviewRow_Click"
                                                        Padding="{StaticResource Space.Padding.M}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 仓库图标：圆角方块 + 分支矢量图形 -->
                                                        <Border Width="36"
                                                                Height="36"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource Brush.Background.Secondary}"
                                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Button}">
                                                            <Path Width="16"
                                                                  Height="16"
                                                                  Data="{StaticResource Icon.Geometry.RepoBranch}"
                                                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                                                  Stretch="Uniform" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Text.Body}"
                                                                       Text="{Binding RepositoryText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding RepositoryText}" />
                                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                                       Style="{StaticResource Text.Secondary}"
                                                                       Text="{Binding VersionSummaryText}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <!--
                                                                徽章默认"已是最新"（绿）。HasUpdate / HasError /
                                                                IsNoRelease 分别着色（见领域规则），
                                                                文字统一取自 BadgeText。
                                                            -->
                                                            <Border x:Name="Badge"
                                                                    Margin="0,0,8,0"
                                                                    Padding="8,3"
                                                                    Background="{DynamicResource Brush.Success.Soft}"
                                                                    CornerRadius="{StaticResource Radius.Badge}">
                                                                <TextBlock x:Name="BadgeText"
                                                                           Foreground="{DynamicResource Brush.Success}"
                                                                           Style="{StaticResource Text.Caption}"
                                                                           Text="{Binding BadgeText}" />
                                                            </Border>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                       Text="›" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Error.Soft}" />
                                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                    </DataTrigger>
                                                    <!--
                                                        "没有可展示内容"类（暂无 Release / 仅预发布 / 版本无法解析）
                                                        取中性色，不用绿色 —— 绿会把它读成"一切正常"。
                                                        2026-10-11：原"基准版本"状态已删除（与"已是最新"同义），
                                                        其触发随之移除。
                                                    -->
                                                    <DataTrigger Binding="{Binding IsNoRelease}" Value="True">
                                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!--
                    检测列表：三栏 Split View（仓库列表 / Release 历史 / Release 详情）。

                    DataContext 沿用窗口级的 OverviewViewModel（两页共享同一次检测），
                    故列表相关绑定需经 DataContext.RepositoryList 下钻。

                    宽屏：三栏并排。窄屏（见 MainWindow.xaml.cs 的响应式处理）：
                    仅显示一级，用返回按钮逐级回退（仓库 → 历史 → 详情）。
                -->
                <Grid x:Name="ReposPage" Visibility="Collapsed"
                      DataContext="{Binding DataContext.RepositoryList, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 页头：标题 + 上次检测 + 加载环 + 立即检查；窄屏额外显示返回按钮 -->
                        <Grid Grid.Row="0" Margin="{StaticResource Size.ContentPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ReposBackButton"
                                    Grid.Column="0"
                                    Visibility="Collapsed"
                                    Command="{Binding BackCommand}"
                                    Margin="{StaticResource Space.Margin.Right.S}"
                                    Padding="8"
                                    ToolTip="返回上一级">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72B;" />
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.PageTitle}" Text="检测列表" />
                                <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                           Style="{StaticResource Text.Secondary}"
                                           Text="{Binding LastRunText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 加载指示：IsBusy 为真时淡入旋转环，结束淡出 -->
                                <Control Style="{StaticResource BusyRing}"
                                         VerticalAlignment="Center"
                                         Margin="{StaticResource Space.Margin.Right.S}"
                                         Visibility="Collapsed"
                                         anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="立即检测全部监控仓库">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}"
                                                   Margin="{StaticResource Space.Margin.Right.S}"
                                                   FontSize="14"
                                                   Text="&#xE72C;" />
                                        <TextBlock Text="立即检查" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 空态：尚无监控仓库 -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="560"
                                    anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding EmptyStateVisibility}">
                            <TextBlock Style="{StaticResource PlaceholderTitle}" Text="尚无监控仓库" />
                            <TextBlock Style="{StaticResource PlaceholderBody}"
                                       Text="点击「立即检查」开始检测。当前使用内置样例数据演示。" />
                        </StackPanel>

                        <!--
                            三栏 Split View：仓库列表 / Release 历史 / Release 详情。

                            版式按 2026-10-11 用户要求重设计：
                              · 三栏宽度可拖拽调整（GridSplitter），比例在拖拽结束后
                                持久化到 config.json（见 LayoutPreferences）；
                              · 各栏 MinWidth 保证仓库名等关键信息不被挤成缩略文字；
                              · 左栏每行只有 仓库名 / 版本摘要 / 短状态，长说明在详情栏；
                              · 中栏按发布时间从新到旧，选中行持续高亮（ListBox 容器样式）；
                              · 右栏重组为 版本信息 / 发布说明 / 下载资产 三块。
                        -->
                        <Grid x:Name="ReposSplit" Grid.Row="1"
                              anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding ListVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MasterCol" Width="0.28*" MinWidth="220" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition x:Name="HistoryCol" Width="0.33*" MinWidth="180" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition x:Name="DetailCol" Width="0.39*" MinWidth="240" />
                            </Grid.ColumnDefinitions>

                            <!-- 左：仓库列表。行 = 仓库名 + 版本摘要 + 短状态（长说明在详情栏） -->
                            <Border x:Name="MasterPane" Grid.Column="0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    ClipToBounds="True">
                                <DockPanel LastChildFill="True">
                                    <Grid DockPanel.Dock="Top" Margin="12,12,12,4">
                                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="仓库" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="{Binding Rows.Count}" />
                                    </Grid>
                                    <ListBox Style="{StaticResource PaneList}"
                                             ItemContainerStyle="{StaticResource PaneListItem}"
                                             ItemsSource="{Binding Rows}"
                                             SelectedItem="{Binding SelectedRow}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Body}"
                                                               Text="{Binding RepositoryText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RepositoryText}" />
                                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                               Style="{StaticResource Text.Secondary}"
                                                               Text="{Binding VersionSummaryText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding VersionSummaryText}" />
                                                    <TextBlock x:Name="RowStatus"
                                                               Margin="{StaticResource Space.Padding.Top.XS}"
                                                               Style="{StaticResource Text.Caption}"
                                                               Text="{Binding BadgeText}" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                        <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter TargetName="RowStatus" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter x:Name="HistorySplitter"
                                          Grid.Column="1"
                                          Style="{StaticResource PaneSplitter}" />

                            <!-- 中：Release 历史（发布时间从新到旧，选中行持续高亮） -->
                            <Border x:Name="HistoryPane" Grid.Column="2"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    ClipToBounds="True">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.CardTitle}"
                                               Margin="12,12,12,4"
                                               Text="Release 历史" />
                                    <!-- 空态：未选仓库 / 仓库没有 Release（与列表互斥淡入） -->
                                    <TextBlock DockPanel.Dock="Top"
                                               Style="{StaticResource PlaceholderBody}"
                                               HorizontalAlignment="Center"
                                               Margin="{StaticResource Space.Margin.M}"
                                               Text="{Binding HistoryEmptyText}"
                                               anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding HistoryEmptyVisibility}" />
                                    <ListBox Style="{StaticResource PaneList}"
                                             ItemContainerStyle="{StaticResource PaneListItem}"
                                             ItemsSource="{Binding SelectedRow.Releases}"
                                             SelectedItem="{Binding SelectedRelease}"
                                             anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding HistoryListVisibility}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 第一行：版本号 + 标记（紧跟版本号，样式同右栏通道胶囊） -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Text.Body}"
                                                                   Text="{Binding TagName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding TagName}" />

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <!-- "最新"轻量标签：仅最新合格项 -->
                                                            <Border Margin="8,0,0,0"
                                                                    Padding="6,2"
                                                                    Background="{DynamicResource Brush.Accent.Soft}"
                                                                    CornerRadius="{StaticResource Radius.Badge}">
                                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Brush.Accent}"
                                                                           Text="最新">
                                                                    <TextBlock.Visibility>
                                                                        <MultiBinding Converter="{StaticResource AreEqualToVisibilityConverter}">
                                                                            <Binding Path="TagName" />
                                                                            <Binding Path="DataContext.SelectedRow.LatestRelease.TagName"
                                                                                     ElementName="ReposPage" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                            </Border>

                                                            <!--
                                                                发布通道：正式版（绿框）/ 预发布（橙框）。
                                                                描边着色而非实心填充，避免在每项都压上色块。
                                                            -->
                                                            <Border x:Name="ChannelPill"
                                                                    Margin="8,0,0,0"
                                                                    Padding="6,2"
                                                                    Background="Transparent"
                                                                    BorderBrush="{DynamicResource Brush.Success}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource Radius.Badge}">
                                                                <TextBlock x:Name="ChannelPillText"
                                                                           Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Brush.Success}"
                                                                           Text="正式版" />
                                                            </Border>

                                                            <!-- 草稿：中性胶囊 -->
                                                            <Border Margin="8,0,0,0"
                                                                    Padding="6,2"
                                                                    Background="{DynamicResource Brush.Surface.Selected}"
                                                                    CornerRadius="{StaticResource Radius.Badge}"
                                                                    Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                           Text="草稿" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 第二行：发布日期（"最新"已在上面用胶囊表达，此处不再重复前缀） -->
                                                    <TextBlock Grid.Row="1"
                                                               Margin="{StaticResource Space.Padding.Top.XS}"
                                                               Style="{StaticResource Text.Secondary}"
                                                               Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd}}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <!-- 预发布：整颗胶囊改橙色 -->
                                                    <DataTrigger Binding="{Binding IsPrerelease}" Value="True">
                                                        <Setter TargetName="ChannelPill" Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                        <Setter TargetName="ChannelPillText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        <Setter TargetName="ChannelPillText" Property="Text" Value="预发布" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter x:Name="DetailSplitter"
                                          Grid.Column="3"
                                          Style="{StaticResource PaneSplitter}" />

                            <!-- 右：Release 详情 —— 版本信息 / 发布说明 / 下载资产 三个连续区块 -->
                            <Border x:Name="DetailPane" Grid.Column="4"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    ClipToBounds="True">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.CardTitle}"
                                               Margin="12,12,12,4"
                                               Text="Release 详情" />
                                    <!-- 空态：未选仓库 / 仓库没有 Release（与详情内容互斥淡入） -->
                                    <TextBlock DockPanel.Dock="Top"
                                               Style="{StaticResource PlaceholderBody}"
                                               HorizontalAlignment="Center"
                                               Margin="{StaticResource Space.Margin.M}"
                                               Text="{Binding DetailEmptyText}"
                                               anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding DetailEmptyVisibility}" />

                                    <ScrollViewer Padding="12,4,12,16"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding DetailContentVisibility}">
                                        <StackPanel>
                                            <!-- ===== 区块一：版本信息 ===== -->
                                            <TextBlock Style="{StaticResource Text.PageTitle}"
                                                       Text="{Binding SelectedRelease.Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedRelease.Title}" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding SelectedRow.RepositoryText}" />
                                            <StackPanel Margin="{StaticResource Space.Padding.Top.S}"
                                                        Orientation="Horizontal">
                                                <!-- 通道徽章：草稿 / 预发布 / 正式版（文字取自 VM） -->
                                                <Border Padding="8,3"
                                                        Background="{DynamicResource Brush.Surface.Selected}"
                                                        CornerRadius="{StaticResource Radius.Badge}">
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               Text="{Binding DetailChannelText}" />
                                                </Border>
                                                <Border Margin="{StaticResource Space.Margin.Right.S}"
                                                        Padding="8,3"
                                                        Background="{DynamicResource Brush.Accent.Soft}"
                                                        CornerRadius="{StaticResource Radius.Badge}"
                                                        anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding DetailUpdatePillVisibility}">
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Accent}"
                                                               Text="有新版本" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding SelectedRelease.PublishedAt, StringFormat=发布于 {0:yyyy-MM-dd HH:mm}}" />

                                            <Border Height="1"
                                                    Margin="{StaticResource Space.Padding.Top.M}"
                                                    Background="{DynamicResource Brush.Border.Subtle}" />

                                            <!-- ===== 区块二：发布说明（面板内滚动） ===== -->
                                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                                       Text="发布说明" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                                                       Style="{StaticResource Text.Body}"
                                                       Text="{Binding DetailNotes}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                                                       Visibility="{Binding SelectedRelease.HtmlUrl, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Hyperlink NavigateUri="{Binding SelectedRelease.HtmlUrl}"
                                                           RequestNavigate="ReleaseLink_RequestNavigate"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           TextDecorations="{x:Null}">
                                                    查看完整 Release →
                                                </Hyperlink>
                                            </TextBlock>

                                            <Border Height="1"
                                                    Margin="{StaticResource Space.Padding.Top.M}"
                                                    Background="{DynamicResource Brush.Border.Subtle}" />

                                            <!-- ===== 区块三：下载资产（逐文件带下载按钮） ===== -->
                                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                                       Text="下载资产" />
                                            <!-- 没有可下载文件时给空态说明，不放禁用大按钮 -->
                                            <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       Text="此 Release 没有可下载资产。"
                                                       anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding AssetEmptyVisibility}" />
                                            <ItemsControl Margin="{StaticResource Space.Padding.Top.S}"
                                                          ItemsSource="{Binding SelectedRelease.Assets}"
                                                          anim:AnimatedVisibilityHelper.AnimatedVisibility="{Binding AssetListVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="{StaticResource Space.Padding.Top.XS}"
                                                                Padding="10,8"
                                                                Background="{DynamicResource Brush.Background.Secondary}"
                                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource Radius.Button}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource Text.Body}"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}" />
                                                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                                                               Style="{StaticResource Text.Caption}"
                                                                               Text="{Binding SizeInBytes, Converter={StaticResource FileSizeConverter}}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Margin="12,0,0,0"
                                                                        Padding="12,4"
                                                                        Style="{StaticResource Button.Base}"
                                                                        Command="{Binding DataContext.DownloadAssetCommand, ElementName=ReposPage}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="通过系统默认浏览器下载该文件">
                                                                    下载
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 下载（占位） -->
                <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Style="{StaticResource PlaceholderTitle}"
                                   Text="下载" />
                        <TextBlock Style="{StaticResource PlaceholderBody}"
                                   Text="将在此展示下载任务与进度（aria2 接入后）。" />
                    </StackPanel>
                </Grid>

                <!-- 设置 -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer Padding="{StaticResource Size.ContentPadding}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="640">

                            <TextBlock Style="{StaticResource Text.SectionTitle}"
                                       Text="外观" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="主题" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="选择应用配色。选择会立即生效并保存；「跟随系统」下切换系统深浅色时界面实时跟随。" />

                                    <StackPanel Margin="{StaticResource Space.Padding.Top.M}"
                                                Orientation="Horizontal">
                                        <TextBlock Margin="{StaticResource Space.Margin.Right.S}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="主题" />
                                        <ComboBox x:Name="ThemeSelector"
                                                  Width="140"
                                                  SelectionChanged="ThemeSelector_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="开发者" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="设计系统" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="查看语义色、字阶、控件三态与间距标尺。用于设计系统的肉眼核对（D-048 验收载体）。" />

                                    <Button x:Name="OpenDesignSystemButton"
                                            Margin="{StaticResource Space.Padding.Top.M}"
                                            HorizontalAlignment="Left"
                                            Content="打开设计系统"
                                            Click="OpenDesignSystem_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="关于" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="ReleaseWatcher" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="GitHub Release 监控与下载工具。" />
                                    <TextBlock x:Name="AboutPathsText"
                                               Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Caption}"
                                               Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Size.ContentPadding}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Text.Caption}"
                       Text="就绪" />
        </Border>
    </Grid>
</Window>
