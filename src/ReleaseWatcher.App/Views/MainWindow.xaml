<Window x:Class="ReleaseWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="ReleaseWatcher">

    <!--
        应用主页 —— 一体化标题栏布局（2026-10-09，参照用户提供的截图）。

        结构（自上而下）：
            1. 标题栏（与窗口一体）：汉堡按钮 + 应用名 + 窗口控制按钮
            2. 主体：Sidebar（可展开/收起，带图标）+ 内容区（四页切换）
            3. 状态栏

        关键实现：
            · WindowStyle=None + WindowChrome：去掉系统标题栏，但保留
              拖动、边缘缩放、Win+方向键贴边、Aero Snap 等系统行为
              （这些由 WindowChrome 的 CaptionHeight / ResizeBorderThickness 提供，
              手写 DragMove 做不到）。
            · 应用名在标题栏；主题选择在「设置」页，不在主页（用户决定）。
            · 「设计系统」入口同属开发调参工具，一并放在设置页。

        所有颜色取自设计系统画刷，不硬编码；新增尺寸键进 Spacing.xaml（D-026）。
    -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="{StaticResource Size.ToolbarHeight}"
            ResizeBorderThickness="{StaticResource Size.ResizeBorderThickness}"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!--
            图标字形：统一用 Segoe MDL2 Assets。

            原写 "Segoe Fluent Icons, Segoe MDL2 Assets" 的回退列表，
            但本机 Segoe Fluent Icons 未安装（SegFluentIcons.ttf 不存在），
            回退首项缺失时字形渲染成"方框"（tofu）—— 2026-10-09 用户反馈
            "按钮均为方框"。Segoe MDL2 Assets（segmdl2.ttf）Win10/11 均自带，
            改用单一字体，不再依赖回退行为。
        -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!--
                刻意不设 HorizontalAlignment：对齐由外层按钮的
                HorizontalContentAlignment 决定（展开靠左 / 收起居中）。
                固定 Center 会让"展开时汉堡靠左"失效。
            -->
        </Style>

        <!--
            ToolTip 隐式样式。

            背景问题：WPF 的 ToolTip 默认走系统样式（浅灰底 + 深色字），
            但本应用有全局隐式 TextBlock 样式（见 Typography.xaml），
            会把 ToolTip 内文字刷成 Brush.Text.Primary ——
            深色主题下那是**浅色**，浅色字落在浅色底上就看不见了，
            表现为"悬停提示框是空白的"（2026-10-09 用户反馈）。

            修法：显式给 ToolTip 设定 Surface 背景与 Border 描边，
            使文字与其底色始终来自同一套语义色（见 D-026 单一来源要求）。
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource Space.Padding.S}" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <!-- 导航图标：额外补图标与文字之间的间距（见 Sidebar 导航项）。 -->
        <Style x:Key="NavIcon" TargetType="TextBlock"
               BasedOn="{StaticResource IconGlyph}">
            <Setter Property="Margin" Value="{StaticResource Space.Margin.Right.S}" />
        </Style>

        <!--
            Sidebar 顶部的展开/收起按钮。
            刻意不用 ChromeButton：后者带 IsHitTestVisibleInChrome，
            那是给标题栏（非客户区）用的，客户区按钮不需要。
        -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="{StaticResource Size.ControlHeightLarge}" />
            <Setter Property="Margin" Value="{StaticResource Space.Margin.S}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左（与下方导航图标对齐），收起时居中。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            标题栏窗口控制按钮（最小化 / 最大化 / 关闭）。
            无边框、hover 提亮 —— 贴近系统标题栏的观感。
            颜色全部走设计系统画刷。
            内容用 IconGlyph 的 TextBlock 而非裸字符串：字体由 TextBlock 显式承担，
            不依赖 Button 到 ContentPresenter 的字体继承。
        -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="{StaticResource Size.ToolbarHeight}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment，
                                 否则固定值会覆盖外面的设置。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Sidebar 导航项：图标 + 文字，选中态提亮。
            收起时文字由代码切换可见性（见 ToggleSidebar_Click）。
        -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="{StaticResource Size.ControlHeightLarge}" />
            <Setter Property="Margin" Value="{StaticResource Space.Margin.S}" />
            <Setter Property="Padding" Value="{StaticResource Space.Padding.Horizontal.M}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <!-- 水平对齐跟随 HorizontalContentAlignment：
                                 展开时靠左，收起时居中（见 ToggleSidebar_Click）。 -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Selected}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Surface.Hover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 占位页居中提示 -->
        <Style x:Key="PlaceholderTitle" TargetType="TextBlock"
               BasedOn="{StaticResource Text.PageTitle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlaceholderBody" TargetType="TextBlock"
               BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Space.Padding.Top.S}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏（与窗口一体） ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Height="{StaticResource Size.ToolbarHeight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    应用名：属于标题拖动区（不加 IsHitTestVisibleInChrome）。
                    汉堡按钮已按用户要求移至 Sidebar 顶部，不占标题栏。
                -->
                <!--
                    Margin 用 Space.Margin.*（Thickness），不用 Space.Padding.Horizontal.*
                    —— "左右双向"的 padding 键用于 Margin 会让相邻元素间隙被翻倍，
                    该规则由 PreviewPage_InterItemGapsMustUseRightOnlyMargin 守护。
                -->
                <TextBlock Grid.Column="0"
                           Margin="{StaticResource Space.Margin.M}"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.CardTitle}"
                           Text="ReleaseWatcher" />

                <!--
                    窗口控制：最小化 / 最大化(还原) / 关闭。
                    图标用 TextBlock 承载（字体由 IconGlyph 显式指定），
                    不用裸字符串 Content —— 后者依赖字体继承，回退失败即显示方框。
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE921;" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Maximize_Click"
                            ToolTip="最大化">
                        <TextBlock x:Name="MaximizeIcon"
                                   Style="{StaticResource IconGlyph}"
                                   Text="&#xE922;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeButton}"
                            Click="Close_Click"
                            ToolTip="关闭">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--
                    Width 由代码设置（ToggleSidebar_Click / 构造函数）：
                    ColumnDefinition.Width 是 GridLength，而 Size.SidebarWidth 是
                    sys:Double —— 直接绑定会抛 XamlParseException（编译期不报错）。
                    尺寸仍在 Spacing.xaml 里，只是经代码读取，保持单一来源。
                -->
                <ColumnDefinition x:Name="SidebarColumn" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <!--
                        汉堡按钮：按用户要求放在 Sidebar 顶部，不再占标题栏。
                        用 SidebarToggleButton（无边框 + hover），
                        不用 ChromeButton —— 后者带 IsHitTestVisibleInChrome，
                        仅标题栏区域需要。
                    -->
                    <Button x:Name="HamburgerButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SidebarToggleButton}"
                            Click="ToggleSidebar_Click"
                            ToolTip="展开 / 收起侧边栏">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE700;" />
                    </Button>

                    <!-- 设置项固定底部（与截图一致） -->
                    <RadioButton x:Name="SettingsNav"
                                 DockPanel.Dock="Bottom"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="Nav"
                                 Tag="Settings"
                                 Checked="Nav_Checked"
                                 ToolTip="设置">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SettingsIcon"
                                           Style="{StaticResource NavIcon}"
                                           Text="&#xE713;" />
                            <TextBlock x:Name="SettingsNavText"
                                       Text="设置" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 主导航 -->
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Space.Padding.Top.S}">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Overview"
                                     IsChecked="True"
                                     Checked="Nav_Checked"
                                     ToolTip="概览">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OverviewIcon"
                                           Style="{StaticResource NavIcon}"
                                           Text="&#xE80F;" />
                                <TextBlock x:Name="OverviewNavText"
                                           Text="概览" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ReposNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Repos"
                                     Checked="Nav_Checked"
                                     ToolTip="检测列表">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ReposIcon"
                                           Style="{StaticResource NavIcon}"
                                           Text="&#xE71D;" />
                                <TextBlock x:Name="ReposNavText"
                                           Text="检测列表" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="DownloadsNav"
                                     Style="{StaticResource NavRadioButton}"
                                     GroupName="Nav"
                                     Tag="Downloads"
                                     Checked="Nav_Checked"
                                     ToolTip="下载">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadsIcon"
                                           Style="{StaticResource NavIcon}"
                                           Text="&#xE896;" />
                                <TextBlock x:Name="DownloadsNavText"
                                           Text="下载" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== 内容区（四页切换） ==================== -->
            <Grid Grid.Column="1">

                <!-- 概览（候选 B 的接入点） -->
                <Grid x:Name="OverviewPage">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Style="{StaticResource PlaceholderTitle}"
                                   Text="尚未添加监控仓库" />
                        <TextBlock Style="{StaticResource PlaceholderBody}"
                                   Text="应用层检测用例已就绪，界面尚未接入。下一步将此处替换为真实的检测列表。" />
                    </StackPanel>
                </Grid>

                <!-- 检测列表（占位） -->
                <Grid x:Name="ReposPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Style="{StaticResource PlaceholderTitle}"
                                   Text="检测列表" />
                        <TextBlock Style="{StaticResource PlaceholderBody}"
                                   Text="将在此展示各仓库的最新版本与检测结果（候选 B）。" />
                    </StackPanel>
                </Grid>

                <!-- 下载（占位） -->
                <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="560">
                        <TextBlock Style="{StaticResource PlaceholderTitle}"
                                   Text="下载" />
                        <TextBlock Style="{StaticResource PlaceholderBody}"
                                   Text="将在此展示下载任务与进度（aria2 接入后）。" />
                    </StackPanel>
                </Grid>

                <!-- 设置 -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer Padding="{StaticResource Size.ContentPadding}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="640">

                            <TextBlock Style="{StaticResource Text.SectionTitle}"
                                       Text="外观" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="主题" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="选择应用配色。选择会立即生效并保存；「跟随系统」下切换系统深浅色时界面实时跟随。" />

                                    <StackPanel Margin="{StaticResource Space.Padding.Top.M}"
                                                Orientation="Horizontal">
                                        <TextBlock Margin="{StaticResource Space.Margin.Right.S}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="主题" />
                                        <ComboBox x:Name="ThemeSelector"
                                                  Width="140"
                                                  SelectionChanged="ThemeSelector_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="开发者" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="设计系统" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="查看语义色、字阶、控件三态与间距标尺。用于设计系统的肉眼核对（D-048 验收载体）。" />

                                    <Button x:Name="OpenDesignSystemButton"
                                            Margin="{StaticResource Space.Padding.Top.M}"
                                            HorizontalAlignment="Left"
                                            Content="打开设计系统"
                                            Click="OpenDesignSystem_Click" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="{StaticResource Space.Padding.Top.L}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="关于" />

                            <Border Margin="{StaticResource Space.Padding.Top.M}"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{StaticResource Space.Padding.M}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="ReleaseWatcher" />
                                    <TextBlock Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Secondary}"
                                               Text="GitHub Release 监控与下载工具。" />
                                    <TextBlock x:Name="AboutPathsText"
                                               Margin="{StaticResource Space.Padding.Top.XS}"
                                               Style="{StaticResource Text.Caption}"
                                               Text="" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Size.ContentPadding}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Text.Caption}"
                       Text="就绪" />
        </Border>
    </Grid>
</Window>
