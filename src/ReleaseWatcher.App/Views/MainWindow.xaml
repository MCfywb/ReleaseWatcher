<Window x:Class="ReleaseWatcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReleaseWatcher">

    <!--
        应用主页（2026-10-09 从设计系统预览页改来）。

        改动原因：预览页把设计系统与界面骨架混在一处，
        调整色板时要在业务结构里辨认"是设计问题还是布局问题"。
        现将设计系统整体迁至 DesignSystemWindow（独立窗口，可随手开关），
        本窗回归其本职 —— 承载应用主界面。

        当前状态：**骨架已就位，内容待接**。
        应用层检测用例（ReleaseDetectionService）已实现，
        但界面尚未绑定 —— 本次刻意不做 UI，只把结构立起来。
        下一步（候选 B）再接入真实数据。

        所有取值均来自 Resources/Theme/Theme.xaml，此处不硬编码任何颜色或字号。
    -->
    <Grid Background="{DynamicResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Toolbar ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Size.ContentPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource Text.CardTitle}"
                           VerticalAlignment="Center"
                           Text="ReleaseWatcher" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 打开设计系统手册：调色板与控件三态的核对入口 -->
                    <Button Margin="{StaticResource Space.Margin.Right.M}"
                            Content="设计系统"
                            Click="OpenDesignSystem_Click" />

                    <!-- 主题切换：浅色 / 深色 / 跟随系统。选择会持久化到 config.json -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="{StaticResource Space.Margin.Right.S}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Secondary}"
                                   Text="主题" />
                        <ComboBox x:Name="ThemeSelector"
                                  Width="120"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Content ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar：原方案一级导航四区（D-027），后续填充 -->
                <ColumnDefinition Width="Auto" MinWidth="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Secondary}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0"
                    Padding="{StaticResource Space.Padding.M}">
                <StackPanel>
                    <TextBlock Margin="{StaticResource Space.Margin.S}"
                               Style="{StaticResource Text.SectionTitle}"
                               Text="监控" />

                    <RadioButton Content="概览"
                                 IsChecked="True"
                                 Margin="{StaticResource Space.Margin.S}"
                                 GroupName="Nav" />
                    <RadioButton Content="检测列表"
                                 Margin="{StaticResource Space.Margin.S}"
                                 GroupName="Nav" />
                    <RadioButton Content="下载"
                                 Margin="{StaticResource Space.Margin.S}"
                                 GroupName="Nav" />
                    <RadioButton Content="设置"
                                 GroupName="Nav" />
                </StackPanel>
            </Border>

            <!-- 主内容区：候选 B 的接入点 -->
            <Grid Grid.Column="1" Margin="{StaticResource Size.ContentPadding}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="560">
                    <TextBlock Style="{StaticResource Text.PageTitle}"
                               Text="尚未添加监控仓库"
                               TextAlignment="Center" />

                    <TextBlock Margin="{StaticResource Space.Padding.Top.S}"
                               Style="{StaticResource Text.Body}"
                               TextAlignment="Center"
                               Text="应用层检测用例已就绪，界面尚未接入。下一步将此处替换为真实的检测列表。" />

                    <TextBlock Margin="{StaticResource Space.Padding.Top.M}"
                               Style="{StaticResource Text.Secondary}"
                               TextAlignment="Center"
                               Text="在此之前，可用右上角「设计系统」查看当前配色、字阶与控件三态。" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== Status Bar ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Background.Secondary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Size.ContentPadding}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Text.Caption}"
                       Text="就绪" />
        </Border>
    </Grid>
</Window>
