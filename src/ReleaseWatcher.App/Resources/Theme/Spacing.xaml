<!--
    Spacing.xaml —— 间距、圆角、控件尺寸常量

    依据：docs/reference/development-plan-ui.md
          第 4.1 节（间距体系、Sidebar / Toolbar / Content 尺寸）
          第七节（圆角）

    为什么把这些做成资源键而不是直接写数字：

        D-026 要求颜色走 Resources/Theme/，同理尺寸也应单一来源。
        界面里出现裸数字时，无法判断它是有意为之还是随手写的，
        也无法统一调整。用键之后，"这里为什么是 13 而不是 16"
        这类问题可以直接在定义处回答。

    WPF 的限制（重要）：

        Thickness / CornerRadius 可直接引用 x:Double 资源键；
        但 Grid 的 Height / Width 这类值转换依赖类型，
        直接引用 Double 键在多数场景可行，却容易遇到隐式转换歧义。
        因此尺寸类（SidebarWidth 等）额外提供了 Thickness 版本，
        需要给Padding / Margin 用时优先用 Thickness 变体。
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         8px 基础间距体系（原文：8 / 16 / 24 / 32 / 40 / 48）
         ============================================================ -->

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.XS">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.S">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.M">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.L">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.XL">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.2XL">40</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.3XL">48</sys:Double>

    <!--
        Space.XS = 4 是原文 8px 体系里没有的值。

        理由：8px 作为最小间距时，图标与文字之间、
        Badge 内边距这类小尺寸无处安放，只能被迫用 8 或更小。
        4 作为"图标与文字"级别的紧贴间距，符合实际需要。
        8px 仍是**布局**的基准，仅在控件内部微调时允许 4。
    -->

    <!-- 常用间距的 Thickness 便捷版本 -->
    <Thickness x:Key="Space.Padding.S">8</Thickness>
    <Thickness x:Key="Space.Padding.M">16</Thickness>
    <Thickness x:Key="Space.Padding.L">24</Thickness>
    <Thickness x:Key="Space.Padding.XL">32</Thickness>

    <!-- ============================================================
         圆角（原文：Card 12 / Button 8 / Input 8 / Badge 6）
         原文明示不要 20~30px 巨大圆角，不要厚重投影、大量渐变。
         目标："轻、静、清晰"。
         ============================================================ -->

    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Input">8</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">6</CornerRadius>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>

    <!-- ============================================================
         布局尺寸（原文第 4.1 节）
         ============================================================ -->

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.SidebarWidth">220</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ToolbarHeight">56</sys:Double>

    <!-- Content 内边距：原文 Horizontal 28~32 / Vertical 24~32，取下限偏保守 -->
    <Thickness x:Key="Size.ContentPadding">28,24</Thickness>

    <!-- 窗口尺寸（原文第 4.1 节） -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowMinWidth">1200</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowMinHeight">760</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowWidth">1440</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowHeight">900</sys:Double>

    <!-- ============================================================
         控件高度
         ============================================================ -->

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ControlHeight">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ControlHeightLarge">36</sys:Double>

    <!--
        32 是取原文 Toolbar 56~64 与常见桌面控件的折中值。
        原方案未直接给出控件高度，此处按 8px 体系取 32（4 个单位），
        与 28/24 的 Content 内边距保持同一节奏。
    -->

    <!-- 描边宽度：原方案强调"少边框"，故仅 1px -->
    <Thickness x:Key="Size.BorderThickness">1</Thickness>

    <!-- 分隔线：Divider。用 Brush.Border 色 -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.DividerThickness">1</sys:Double>

</ResourceDictionary>