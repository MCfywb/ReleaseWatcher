<!--
    Spacing.xaml —— 间距、圆角、控件尺寸常量

    依据：docs/reference/development-plan-ui.md
          第 4.1 节（间距体系、Sidebar / Toolbar / Content 尺寸）
          第七节（圆角）

    为什么把这些做成资源键而不是直接写数字：

        D-026 要求颜色走 Resources/Theme/，同理尺寸也应单一来源。
        界面里出现裸数字时，无法判断它是有意为之还是随手写的，
        也无法统一调整。用键之后，"这里为什么是 13 而不是 16"
        这类问题可以直接在定义处回答。

    WPF 的限制（重要）：

        Thickness / CornerRadius 可直接引用 x:Double 资源键；
        但 Grid 的 Height / Width 这类值转换依赖类型，
        直接引用 Double 键在多数场景可行，却容易遇到隐式转换歧义。
        因此尺寸类（SidebarWidth 等）额外提供了 Thickness 版本，
        需要给Padding / Margin 用时优先用 Thickness 变体。
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         8px 基础间距体系（原文：8 / 16 / 24 / 32 / 40 / 48）
         ============================================================ -->

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.XS">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.S">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.M">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.L">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.XL">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.2XL">40</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Space.3XL">48</sys:Double>

    <!--
        Space.XS = 4 是原文 8px 体系里没有的值。

        保留理由：8px 作为**布局**最小间距合适，但控件**内部**的微调放不下。
        典型场景（均已在 Controls.xaml 中实际使用）：
            · CheckBox 勾选框与文字之间的图标级间距
            · ComboBox 下拉面板与控件外框的贴合间隙
            · 下拉列表项（ComboBoxItem）的内容内边距

        这些位置若用 8，下拉面板会与控件脱开 8px，看起来像两层浮空；
        用 0 又会让勾号紧贴文字。因此 4 不是随意取整，
        而是"图标级 / 贴合级"间距 —— 8px 体系仍作为布局基准。
    -->

    <!-- 常用间距的 Thickness 便捷版本 -->
    <Thickness x:Key="Space.Padding.S">8</Thickness>
    <Thickness x:Key="Space.Padding.M">16</Thickness>
    <Thickness x:Key="Space.Padding.L">24</Thickness>
    <Thickness x:Key="Space.Padding.XL">32</Thickness>

    <!--
        输入框内容内边距：左右 Space.M（16），上下 6。

        上下不对称是有意的：输入框高度 32 已定，
        上下各 6 恰好把 14px 文字置于垂直正中且不显拥挤。
        若上下也用 16，输入框高度会被内容撑到 48 上下，视觉过重。
    -->
    <Thickness x:Key="Space.Padding.Input">16,6</Thickness>

    <!--
        横向留白、纵向为 0 的便捷变体。

        为什么必须单独定义：WPF 的 MarkupExtension 一旦闭合，
        后面不允许再跟字面量。因此 "{StaticResource Space.Padding.M},0"
        是**语法错误**（MC3044），不能靠拼接实现。
        凡需要"某方向留白、另一方向为 0"，都得有对应 Thickness 键。
    -->
    <Thickness x:Key="Space.Padding.Horizontal.S">8,0</Thickness>
    <Thickness x:Key="Space.Padding.Horizontal.M">16,0</Thickness>
    <Thickness x:Key="Space.Padding.Horizontal.L">24,0</Thickness>
    <Thickness x:Key="Space.Padding.Horizontal.XL">32,0</Thickness>

    <!--
        仅右侧留白（Left=0, Right=N），用于水平 StackPanel 中**相邻元素之间的间隙**。

        ⚠️ 为什么必须有这个键，而不是复用在 `Space.Padding.Horizontal.*`：

        `Space.Padding.Horizontal.S` = "8,0"，按 Thickness 语义是
        **左右各 8**（Left=8, Right=8）。若把它同时赋给两个相邻元素，
        间隙 = 左元素的 Right(8) + 右元素的 Left(8) = **16**，是预期的两倍；
        更糟的是，若最后一个元素没赋（常见写法），间隙就变成 16 与 8 交替 ——
        用户肉眼可见"三个框间距不一样"。

        这是 2026-10-09 实际发生并修复的故障（见 DECISIONS.md D-046 第 11 条）。
        结论：水平 StackPanel 内的**元素间间隙**必须用右侧单边键，
        且只赋给"除最后一个外的每个元素"，才能保证间隙正好 = N 且处处相等。

        `Space.Padding.Horizontal.*` 此后只用于控件**内部**的左右内边距
        （Button / ComboBox 的 Padding），不得用于元素之间的 Margin。
    -->
    <Thickness x:Key="Space.Margin.Right.S">0,0,8,0</Thickness>
    <Thickness x:Key="Space.Margin.Right.M">0,0,16,0</Thickness>
    <Thickness x:Key="Space.Margin.Right.L">0,0,24,0</Thickness>
    <Thickness x:Key="Space.Margin.Right.XL">0,0,32,0</Thickness>

    <!--
        纵向留白、横向为 0。UI 中最常用的一类：
        元素之间的上下间距。
    -->
    <Thickness x:Key="Space.Padding.Top.XS">0,4</Thickness>
    <Thickness x:Key="Space.Padding.Top.S">0,8</Thickness>
    <Thickness x:Key="Space.Padding.Top.M">0,16</Thickness>
    <Thickness x:Key="Space.Padding.Top.L">0,24</Thickness>

    <!-- 元素之间的等向间距（如色块之间的 12） -->
    <Thickness x:Key="Space.Margin.S">8</Thickness>
    <Thickness x:Key="Space.Margin.XS">4</Thickness>

    <!-- 圆角与间距体系中的语义变体（用于 Thickness 场景） -->
    <Thickness x:Key="Space.Margin.M">16</Thickness>
    <Thickness x:Key="Space.Margin.L">24</Thickness>
    <Thickness x:Key="Space.Margin.XL">32</Thickness>

    <!-- ============================================================
         圆角（原文：Card 12 / Button 8 / Input 8 / Badge 6）
         原文明示不要 20~30px 巨大圆角，不要厚重投影、大量渐变。
         目标："轻、静、清晰"。
         ============================================================ -->

    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Input">8</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">6</CornerRadius>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>

    <!-- ============================================================
         布局尺寸（原文第 4.1 节）
         ============================================================ -->

    <!--
        Sidebar 展开宽度 = 窗口宽度 × 10%（2026-10-11 用户要求），
        由 MainWindow 按窗口实际宽度运行时计算，不再用固定键。
        此处仅定义其**下限**：正方形窗口（宽 1000）下 10% 只有 100px，
        放不下"图标 + 文字"导航项（约需 120px），故与 120 取较大值。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.SidebarWidth.Min">120</sys:Double>
    <!--
        Sidebar 收起态宽度 = 48：对应 WinUI NavigationView 的
        CompactPaneLength 标准值（仅图标、图标居中）。
        刻意不复用 Size.ControlHeight（32，那是输入框高度，不是导航项）。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.SidebarWidth.Collapsed">48</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ToolbarHeight">56</sys:Double>

    <!--
        可缩放边框：无边框窗口下鼠标抓握的边缘宽度。
        刻意不同于 Size.BorderThickness（那只是 1px 描边，太窄抓不住）。
        这是 Thickness 类型 —— WindowChrome.ResizeBorderThickness 要的正是它。
    -->
    <Thickness x:Key="Size.ResizeBorderThickness">6</Thickness>

    <!--
        导航项高度 = 40：WinUI NavigationView 的 item 标准高度。
        刻意不复用 Size.ControlHeightLarge（36，那是输入框高度）。
        导航项与输入框在 Fluent 规范里是两种不同的尺寸。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.NavItemHeight">40</sys:Double>

    <!--
        导航图标与文字之间的间距 = 16。
        Fluent 规范里图标与标签的水平间隙，与 8px 网格一致。
    -->
    <Thickness x:Key="Size.NavIconGap">0,0,16,0</Thickness>

    <!-- Content 内边距：原文 Horizontal 28~32 / Vertical 24~32，取下限偏保守 -->
    <Thickness x:Key="Size.ContentPadding">28,24</Thickness>

    <!--
        窗口尺寸。

        2026-10-11 用户要求：启动窗口改为正方形（1000 × 1000）。
        最小尺寸同步下调到 800 × 640 —— 原最小宽 1200 大于新启动宽 1000，
        WPF 会把 Width 钳制到 MinWidth，导致"正方形"名存实亡；
        下调后启动尺寸才真正生效。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowMinWidth">800</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowMinHeight">640</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowWidth">1000</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.WindowHeight">1000</sys:Double>

<!-- ============================================================
     控件高度
     ============================================================ -->

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ControlHeight">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.ControlHeightLarge">36</sys:Double>

    <!--
        间距体系的宽度版本（x:Double）。

        为什么 Space.* 不够用：Space.* 是 sys:Double，直接写
        Width="{StaticResource Space.XS}" 在模板内会抛
        FormatException（LengthConverter 无法把资源引用解析为 Length）。
        因此凡用于 Width / Height，需改用本组 Thickness 版本以外
        的 x:Double 键 —— 它们语义相同，只是换个类型。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.XS">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.S">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.M">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.L">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.XL">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.2XL">40</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.Space.3XL">48</sys:Double>

    <!--
        32 是取原文 Toolbar 56~64 与常见桌面控件的折中值。
        原方案未直接给出控件高度，此处按 8px 体系取 32（4 个单位），
        与 28/24 的 Content 内边距保持同一节奏。
    -->

    <!-- 描边宽度：原方案强调"少边框"，故仅 1px -->
    <Thickness x:Key="Size.BorderThickness">1</Thickness>

    <!-- 分隔线：Divider。用 Brush.Border 色 -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Size.DividerThickness">1</sys:Double>

</ResourceDictionary>