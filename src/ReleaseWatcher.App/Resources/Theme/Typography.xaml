<!--
    Typography.xaml —— 字体与字阶

    依据：docs/reference/development-plan-ui.md 第五节「字体」。

    字体选择：Segoe UI Variable

        原文明示：**不要把 SF Pro / SF Symbols 当作程序依赖**，
        推荐系统字体 Segoe UI Variable。
        因此这里只设FontFamily，不打包任何字体资源。

    字阶（原文区间 → 本轮取值）：

        Page Title      28~32 / Semibold  → 28
        Section Title   20~22 / Semibold  → 20
        Card Title      16~17 / Semibold  → 16
        Body            14~15 / Regular   → 14
        Secondary       13~14 / Regular   → 13
        Caption         12~13             → 12

    关于 Semibold：

        原方案要求 Semibold，但 WPF 的 FontWeight 只有枚举值，
        没有 Semibold。用 FontWeight="SemiBold"（数值 600）最贴近。
        若目标系统没有该字重，会自动回落到 Regular 或 Bold。

    用法：

        <TextBlock Style="{StaticResource Text.PageTitle}" Text="概览" />
        或直接：
        <TextBlock FontSize="28" FontWeight="SemiBold" />
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         字体族
         ============================================================ -->

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!--
        等宽字体：版本号、哈希等应等宽对齐的场景。
        Cascadia Mono 随 Windows Terminal / PowerShell 预装，
        Consolas 是更老的兜底。
    -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================================================
         文字样式
         ============================================================ -->

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <!-- 标题行高：28px 字号配 34px 行高，避免中文字形被裁切 -->
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- 数值展示（Dashboard 统计卡片的大数字） -->
    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!--
        全局默认：应用字体 + 正文样式。
        由 Theme.xaml 注入 Application.Resources，
        因此所有控件默认即为正文字体，无需逐处指定。
    -->
    <Style x:Key="Text.Default" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!--
        默认样式：隐式应用于所有 TextBlock。

        用隐式样式而非逐处设Style，是为了让"全应用字体统一"
        成为默认行为 —— 漏设样式时退回到正确的默认，而不是系统默认。
    -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Default}" />

</ResourceDictionary>