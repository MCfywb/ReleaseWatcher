<!--
    Colors.Light.xaml —— 浅色主题的语义色（D-026：禁止硬编码颜色）

    依据：docs/reference/development-plan-ui.md 第六节「颜色体系」。

    设计原则（原文）：

        不要做"彩色软件"。主界面整体浅灰，Surface 接近纯白，
        文字接近黑 / 中性灰，Accent 蓝色，状态色仅用于表达状态。

    为什么按语义而非按颜色组织：

        Apple HIG 强调颜色应承担明确语义 —— 不要让同一个颜色
        同时表达不同含义，也不要只靠颜色传达状态。
        因此这里是 Background / Surface / Text / Border / Accent / 状态色
        这样的语义键，而不是 Red / Blue / Gray 这类颜色名。

    使用方式：

        <Border Background="{DynamicResource Brush.Surface}" />

    必须用 DynamicResource 而非 StaticResource：
    主题切换时 StaticResource 不会重新求值（D-045）。
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景层 -->
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="#EBEBF0" />

    <!-- 表面：卡片、输入框等"浮在背景上"的容器 -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />

    <!--
        交互态用"半透明黑/ 白"而非各定义一个实色。

        好处：同一份叠加色叠加在 Surface、Background 等不同底色上
        都能得到合理结果，无需逐一配色 —— 这也是 Apple HIG 的做法。

        注意 Opacity 必须与画刷一起定义：若把这两个键指向一份共享的
        纯色画刷，主题切换时只换颜色不换透明度，深色主题下叠加层
        会退化成不透明色块。因此每个主题各自完整定义，不要抽取共用。
    -->
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#000000" Opacity="0.04" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="#000000" Opacity="0.07" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="#000000" Opacity="0.11" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#6E6E73" />

    <!-- 反色文字：用于 Accent 按钮上的白字 -->
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- 描边：低对比灰。原方案强调"少边框" -->
    <SolidColorBrush x:Key="Brush.Border" Color="#D2D2D7" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E5E5EA" />

    <!--
        强调色与状态色

        Accent 由 #007AFF 提亮至 #0A84FF（2026-10-09，用户反馈"略微过暗"）。
        提亮后与深色主题的 Accent 一致，全应用只存在一个蓝色值。

        代价：白字在 #0A84FF 上的对比度约 3.0:1（原先 #007AFF 约 3.6:1），
        仍高于 WCAG AA 对"大字号文本"的要求（3:1），
        但 14px Regular 的按钮文字已低于 AA 正文线（4.5:1）。
        因此 Primary 按钮文字建议 14px Semibold —— Semibold 可按大字号处理。
    -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0A84FF" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#3A9BFF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#28A745" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E8862A" />
    <SolidColorBrush x:Key="Brush.Error" Color="#D9342B" />

</ResourceDictionary>