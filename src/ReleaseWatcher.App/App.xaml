<Application x:Class="ReleaseWatcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ReleaseWatcher.App">
    <!--
        StartupUri 已移除（原本为 MainWindow.xaml）。

        原因：主窗口改为由 DI 容器创建，以便其构造函数可注入依赖
        （见 App.xaml.cs 的 OnStartup）。保留 StartupUri 会导致窗口被自动
        实例化两次 —— 一次无依赖的默认实例，一次容器创建的实例。

        ShutdownMode 保持 WPF 默认值 OnLastWindowClose。
        此前设为 OnExplicitShutdown 是为托盘预留（DECISIONS.md D-026
        「设置项含关闭窗口时最小化到托盘」），但托盘尚未实现，
        结果是关闭主窗口后进程无窗口残留 —— 用户看不到任何界面，
        进程却仍在运行，只能靠任务管理器结束。

        改为默认值的代价：将来实现托盘时，若要恢复「关闭主窗口而进程留存」
        的行为，需重新设为 OnExplicitShutdown，并由托盘菜单项显式调用
        Application.Current.Shutdown()。届时应在 App.xaml.cs 的
        OnExit 中确保事件订阅被解除（见 ThemeManager.StartWatchingSystemChanges）。

        前提条件（决定何时能改回去）：托盘已实现，且设置项
        「关闭窗口时最小化到托盘」已实际生效。见 NOW.md 待修项。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    设计系统（D-046）。这里只引用合并入口 Theme.xaml，
                    后续新增设计系统字典只改Theme.xaml 一处，
                    不必再动 App.xaml。
                -->
                <ResourceDictionary Source="/ReleaseWatcher.App;component/Resources/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>