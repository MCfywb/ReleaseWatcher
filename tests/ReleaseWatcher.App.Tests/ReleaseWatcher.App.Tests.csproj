<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ReleaseWatcher 应用层单元测试项目（D-040 的已知例外）
    ============================================================
    职责：测试 App 层中的 ViewModel 构造逻辑（如 RepositoryRowViewModel 携带 Release 历史）。

    引用策略（D-040 的基本原则仍成立，此处为已知例外，已在 NOW.md 记录待办）：
      D-040 禁止测试项目引用 WPF App，以免把 WPF 与 net10.0-windows 拖进测试进程、
      破坏跨平台测试能力。本机为 Windows，本地 build.cmd test 可正常承载；
      一旦需要在非 Windows 上跑测试，应把被测的"纯构造逻辑"抽到无 WPF 依赖的库再测。

      现有 LayeringTests 仅枚举三个已知测试项目，新建的本项目不会触发
      UnitTestProject_MustNotReferenceWpfApp 断言失败（该断言未覆盖本项目，
      属于 D-040 守护的盲区）。后续应在 LayeringTests 显式登记本项目、或重构后移除本例外。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReleaseWatcher.App\ReleaseWatcher.App.csproj" />
  </ItemGroup>

</Project>
